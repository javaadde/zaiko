rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function companyDoc(companyId) {
      return firestore.get(/databases/(default)/documents/companies/$(companyId));
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && request.auth.uid in companyDoc(companyId).data.members;
    }

    match /company-logos/{companyId}/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId);
    }

    match /inventory/{companyId}/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
