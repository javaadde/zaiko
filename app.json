{
  "expo": {
    "name": "TakeOne Mobile",
    "slug": "takeone",
    "version": "1.0.0",
    "scheme": "takeone",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.takeone.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E1A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.takeone.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "TakeOne needs camera access to take product photos for your inventory."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TakeOne to access your camera",
          "microphonePermission": "Allow TakeOne to access your microphone"
        }
      ],
      "expo-av"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "202d45d4-6639-4e0d-bcda-db245aaff5e4"
      }
    }
  }
}
